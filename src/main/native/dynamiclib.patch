+#ifdef NUKED_SC55_SHARED
+extern "C" {
+
+SC55_API void SC55_postUART(uint8_t data)
+{
+    MCU_PostUART(data);
+}
+
+// returns 1 while the emulator is running and SC55_readSamples() delivers sound
+SC55_API int SC55_isReady(void)
+{
+    return (work_thread_run && sample_buffer) ? 1 : 0;
+}
+
+// output sample rate in Hz (16bit signed, stereo), valid after SC55_isReady() returns 1
+SC55_API int SC55_getSampleRate(void)
+{
+    return (mcu_mk1 || mcu_jv880) ? 64000 : 66207;
+}
+
+// copies len int16 samples (interleaved L/R) into buf, returns the number of samples copied
+SC55_API int SC55_readSamples(int16_t *buf, int len)
+{
+    if (!work_thread_run || !sample_buffer || !buf || len <= 0)
+        return 0;
+    len &= ~1;
+    int done = 0;
+    while (done < len)
+    {
+        int n = audio_buffer_size - sample_read_ptr;
+        if (n > len - done)
+            n = len - done;
+        memcpy(&buf[done], &sample_buffer[sample_read_ptr], n * sizeof(short));
+        memset(&sample_buffer[sample_read_ptr], 0, n * sizeof(short));
+        sample_read_ptr = (sample_read_ptr + n) % audio_buffer_size;
+        done += n;
+    }
+    return done;
+}
+
+// makes SC55_run() return
+SC55_API void SC55_quit(void)
+{
+    sc55_quit_requested = true;
+}
+
+} // extern "C"
+
+SC55_API int SC55_run(int argc, char *argv[])
+#else
 int main(int argc, char *argv[])
+#endif
+
 {
